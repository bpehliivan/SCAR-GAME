{
  "name": "scar-stunts",
  "version": "1.0.0",
  "private": true,
  "description": "SCAR Stunts - Masaustu surumu (Electron)",
  "author": "SCAR Stunts",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "dist:exe": "npm run build && electron-builder --win portable --x64",
    "dist:all": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.scarstunts.desktop",
    "productName": "SCAR Stunts",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "public/favicon.ico"
    }
  }
}
